FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 164.3;

boundaryField
{
    gox-inlet
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.001;
        value           uniform 164.3;
    }
    gch4-inlet
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.001;
        value           uniform 164.3;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 164.3;
        value           uniform 164.3;
    }
    "(post_wall|chamber_wall_up|chamber_wall_side|chamber_wall_down|gch4_inlet_outer_wall|face_plate)"
    {
        type            epsilonWallFunction;
        value           uniform 164.3;
    }
}

