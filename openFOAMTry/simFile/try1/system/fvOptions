FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitT
{
    type            limitTemperature;
    min             250;
    max             3500;
    selectionMode   all;
}

limitNut
{
    type            limitTurbulenceViscosity;
    max             1e-2;
    selectionMode   all;
}

