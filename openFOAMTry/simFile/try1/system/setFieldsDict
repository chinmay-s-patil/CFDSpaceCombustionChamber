FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue T 300
    volScalarFieldValue O2 0.233
    volScalarFieldValue N2 0.767
    volScalarFieldValue CH4 0
    volScalarFieldValue H2O 0
    volScalarFieldValue CO2 0
    volScalarFieldValue CO 0
    volScalarFieldValue H2 0
    volScalarFieldValue OH 0
);

regions
(
    cellToCell
    {
        set ignitionKernel;
        fieldValues
        (
            volScalarFieldValue T 2500
            volScalarFieldValue H2O 0.35
            volScalarFieldValue CO2 0.15
            volScalarFieldValue CO 0.30
            volScalarFieldValue H2 0.15
            volScalarFieldValue OH 0.05
            volScalarFieldValue O2 0
            volScalarFieldValue N2 0
            volScalarFieldValue CH4 0
        );
    }
);

